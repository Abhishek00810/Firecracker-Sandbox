FROM alpine:3.20

# System packages
RUN apk add --no-cache \
    bash \
    busybox \
    iproute2 \
    util-linux \
    ca-certificates \
    curl \
    git \
    openssh-client \
    python3 \
    py3-pip \
    nodejs \
    npm

# Python kernel stack for stateful Python execution (kernel_bridge.py)
RUN pip install --no-cache-dir --break-system-packages \
    ipykernel==7.2.0 \
    ipython==9.12.0 \
    jupyter_client==8.8.0 \
    jupyter_core==5.9.1 \
    pyzmq==27.1.0 \
    debugpy==1.8.20 \
    psutil==7.2.2

# Bridge scripts for stateful Python/Node execution
COPY guest-agent/kernel_bridge.py /usr/local/bin/kernel_bridge.py
COPY guest-agent/node_bridge.js   /usr/local/bin/node_bridge.js

# Git: never prompt for credentials inside a VM
RUN git config --global credential.helper ""
ENV GIT_TERMINAL_PROMPT=0

# Bake in DNS so VMs can resolve hostnames without relying on network config flow
RUN echo "nameserver 8.8.8.8" > /etc/resolv.conf

# Make `pip install` work out of the box for users. Sandbox VMs are ephemeral and
# single-use, so installing into the system environment is fine — without this, PEP 668
# ("externally-managed-environment") makes every user `pip install` fail.
RUN printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf

# Bake the guest network identity. Every VM uses the same address: the slot design
# renames each slot's TAP to the template's name and assigns the same host IP
# (172.16.0.1), and the guest is 172.16.0.2. Baking this here removes the per-VM
# runtime rootfs mount that used to write it at boot (and the mount leak that caused).
RUN printf 'GUESTIP=172.16.0.2\nGWIP=172.16.0.1\n' > /etc/vm-network.env

RUN mkdir -p /workspace

# guest-agent baked into the image (previously injected by server.sh at runtime via a
# loop mount). Baking removes the last runtime rootfs mount. NOTE: updating the agent
# now requires rebuilding the rootfs (build_rootfs.sh), not just restarting the server.
COPY guest-agent/guest-agent-amd64 /usr/local/bin/guest-agent
RUN chmod +x /usr/local/bin/guest-agent
