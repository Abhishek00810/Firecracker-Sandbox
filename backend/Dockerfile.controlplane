# Control plane (cmd/control-plane): auth + Postgres + REST API, no VMs.
# Runs on any host — no KVM, Firecracker assets, or privileged networking.
# Build context: this backend/ directory. The host agent (cmd/worker) is not
# containerized — it runs on the KVM host via renderops-start.sh.
FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/control-plane ./cmd/control-plane

FROM alpine:3.21 AS runtime

# ca-certificates supports TLS to managed Postgres and private services.
RUN apk --no-cache add ca-certificates && adduser -D -H -u 10001 app
USER app

COPY --from=build /out/control-plane /usr/local/bin/control-plane

EXPOSE 8080
ENTRYPOINT ["control-plane"]
