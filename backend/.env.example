# Copy to backend/.env on the deployment host. server.sh / renderops-start.sh
# source this file before starting the binary.

# ── Control plane (cmd/control-plane) — needs ONLY this section ──────────────
# Runs anywhere (no KVM/Firecracker). Same host as the SvelteKit app.

# Postgres — same DB the SvelteKit app owns (schema + seeds via pnpm db:init)
DATABASE_URL="postgres://user:password@host:5432/renderops"

# Better Auth session tokens are validated against the DB; these are only for
# legacy Supabase JWT support. Leave empty if unused.
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""

PORT="8080"
LOG_LEVEL="info"    # info | debug
LOG_FORMAT="json"   # json | text

# ── Full VM host (cmd/api, later cmd/agent) — ADDITIONALLY needs these ───────
# Linux + KVM only. Most have working defaults; set to override.

# HOST_VALIDATION_MODE="strict"        # strict | warn (warn = boot without /dev/kvm)
# ASSETS_PATH="/app/assets"            # kernel/, rootfs/, initramfs.cpio.gz
# FIRECRACKER_BINARY="/app/firecracker/firecracker-v1.7.0-aarch64"
# SOCKET_DIR="/tmp/fc-sockets"
# SNAPSHOT_DIR="/dev/shm/fc-snapshots"
# SLOT_COUNT="50"                      # must match server.sh network slots (it exports this)
# MAX_CONCURRENT_PROVISIONS=""         # default: host CPU count
# PRO_RESERVED_PROVISIONS=""           # default: quarter of budget, min 1
# FC_RUN_UID=""                        # set by start scripts (privilege drop)
# FC_RUN_GID=""
