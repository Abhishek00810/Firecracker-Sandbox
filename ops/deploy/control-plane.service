# RenderOps Control Plane — runs on the basic server (D2s v3).
# The binary opens its OWN SSH tunnel to the worker (SSH_COMMAND in the env
# file), so there is no separate tunnel service to depend on.
# Install: sudo cp control-plane.service /etc/systemd/system/renderops-control-plane.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now renderops-control-plane
[Unit]
Description=RenderOps Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renderops
# HOME must be set so the ssh child process (the worker tunnel) can resolve
# ~/.ssh; the key + known_hosts live under /opt/renderops.
Environment=HOME=/opt/renderops
ExecStart=/opt/renderops/renderops-control-plane
EnvironmentFile=/etc/renderops/control-plane.env
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
