# RenderOps Worker — runs on the bare-metal Firecracker host.
# Boots and manages microVMs, so it runs privileged (KVM, netns, cgroups).
# Install: sudo cp worker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now renderops-worker
[Unit]
Description=RenderOps Worker (Firecracker host agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root: Firecracker needs KVM, network namespaces, TAP devices, cgroups.
User=root
ExecStart=/opt/renderops/renderops-worker
EnvironmentFile=/etc/renderops/worker.env
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
