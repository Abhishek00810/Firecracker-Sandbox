# SSH tunnel: control-plane box -> worker's loopback API on the bare-metal host.
# Runs on the basic server. Keeps a persistent forward so the control plane can
# reach http://127.0.0.1:9876 (the worker) without the worker being exposed
# publicly. autossh restarts the tunnel if it drops.
#
# The key at /etc/renderops/tunnel_key must be a DEDICATED key whose
# authorized_keys entry on the worker host is restricted to:
#   command="",no-pty,permitopen="127.0.0.1:9876" ssh-ed25519 AAAA...
# so it can open only this one forward and nothing else.
#
# Set WORKER_SSH_HOST / WORKER_SSH_USER below to the bare-metal host.
[Unit]
Description=RenderOps worker SSH tunnel (control-plane -> worker:9876)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renderops
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new \
  -i /etc/renderops/tunnel_key \
  -L 127.0.0.1:9876:127.0.0.1:9876 \
  WORKER_SSH_USER@WORKER_SSH_HOST
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
