# Copy to /opt/renderops/.env on the basic server and fill in real values.
# docker compose reads this automatically. Never commit the real .env.

# --- database (dev: local postgres container; prod: managed DB) ---
POSTGRES_PASSWORD=

# --- control plane -> worker ---
WORKER_TOKEN=
WORKER_SSH_HOST=20.228.220.165
WORKER_SSH_USER=renderopsadmin

# --- platform (SvelteKit / Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dev.renderops.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
